<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vendas - Agrovale</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="sidebar">
    <h2>Agrovale</h2>
    <ul>
      <li><a href="/dashboard">🏠 Início</a></li>
      <li><a href="/produtos">📦 Produtos</a></li>
      <li><a href="/vendas">💰 Vendas</a></li>
      <li><a href="/estatisticas">📊 Estatísticas</a></li>
      <li><a href="/clientes">👤 Clientes</a></li>
      <li><a href="/relatorios/auditoria">🧾 Auditoria</a></li>
      <li><a href="/logout">🚪 Sair</a></li>
    </ul>
  </div>

  <div class="content">
    <header><h1>Agrovale — Painel Administrativo</h1></header>

    <div class="text-center">
      <a href="/vendas/nova" class="btn btn-success">+ Nova Venda</a>
    </div>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Cliente</th>
          <th>Data</th>
          <th>Valor Total</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (vendas.length === 0) { %>
          <tr><td colspan="5" class="text-center">Nenhuma venda registrada.</td></tr>
        <% } else { %>
          <% vendas.forEach(venda => { %>
            <tr>
              <td><%= venda.VendaID %></td>
              <td><%= venda.ClienteNome %></td>
              <td><%= new Date(venda.DataVenda).toLocaleDateString('pt-BR') %></td>
              <td>R$ <%= Number(venda.ValorLiquido || 0).toFixed(2) %></td>
              <td>
                <a href="/vendas/detalhes/<%= venda.VendaID %>" class="btn btn-primary">Detalhes</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>