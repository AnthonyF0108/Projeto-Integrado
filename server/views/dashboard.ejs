<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Agrovale</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="sidebar">
    <h2>Agrovale</h2>
    <ul>
      <li><a href="/dashboard">🏠 Início</a></li>
      <li><a href="/produtos">📦 Produtos</a></li>
      <li><a href="/vendas">💰 Vendas</a></li>
      <li><a href="/estatisticas">📊 Estatísticas</a></li>
      <li><a href="/clientes">👤 Clientes</a></li>
      <li><a href="/relatorios/auditoria">🧾 Auditoria</a></li>
      <li><a href="/logout">🚪 Sair</a></li>
    </ul>
  </div>

  <div class="content">
    <header><h1>Agrovale — Painel Administrativo</h1></header>
    <div class="dashboard-center">
      <form action="/dashboard" method="GET">
        <input 
          type="text" 
          name="termo" 
          placeholder="🔍 Pesquisar produto por nome, código ou código reduzido..." 
          value="<%= termo || '' %>" 
          required
        >
        <button type="submit">Buscar</button>
      </form>

      <div class="dashboard-buttons">
        <a href="/clientes/novo" class="btn btn-secondary">👤 Cadastrar Novo Cliente</a>
        <a href="/vendas/nova" class="btn btn-success">💰 Nova Venda</a>
        <a href="/produtos/entrada" class="btn btn-primary">📥 Entrada de Mercadorias</a>
      </div>
    </div>

    <% if (produtos && produtos.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Preço de Venda</th>
          </tr>
        </thead>
        <tbody>
          <% produtos.forEach(p => { %>
            <tr>
              <td><%= p.Codigo %></td>
              <td><%= p.Nome %></td>
              <td>R$ <%= parseFloat(p.PrecoVenda || 0).toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else if (termo) { %>
      <p class="no-results">Nenhum produto encontrado para "<%= termo %>".</p>
    <% } %>
  </div>
</body>
</html>
