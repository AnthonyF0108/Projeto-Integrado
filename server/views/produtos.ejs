<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Produtos - Agrovale</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="sidebar">
    <h2>Agrovale</h2>
    <ul>
      <li><a href="/dashboard">🏠 Início</a></li>
      <li><a href="/produtos">📦 Produtos</a></li>
      <li><a href="/vendas">💰 Vendas</a></li>
      <li><a href="/estatisticas">📊 Estatísticas</a></li>
      <li><a href="/clientes">👤 Clientes</a></li>
      <li><a href="/relatorios/auditoria">🧾 Auditoria</a></li>
      <li><a href="/logout">🚪 Sair</a></li>
    </ul>
  </div>

  <div class="content">
    <header><h1>📦 Lista de Produtos</h1></header>
    <div class="text-center">
      <a href="/produtos/criar" class="btn btn-success">+ Novo Produto</a>
    </div>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Nome</th>
          <th>Categoria</th>
          <th>Preço de Venda</th>
          <th>Estoque Atual</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (!produtos || produtos.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center">Nenhum produto cadastrado.</td>
          </tr>
        <% } else { %>
          <% produtos.forEach(p => { %>
            <tr class="<%= p.Ativo === 0 ? 'inativo' : '' %>">
              <td><%= (p.Codigo || p.ProdutoID).toString().padStart(5, '0') %></td>
              <td>
                <%= p.Nome %>
                <% if (p.Ativo === 0) { %>
                  <span class="status-inativo">(Inativo)</span>
                <% } %>
              </td>
              <td><%= p.Categoria || '-' %></td>
              <td>R$ <%= p.PrecoVenda ? p.PrecoVenda.toFixed(2) : '0.00' %></td>
              <td><%= p.EstoqueAtual || 0 %></td>
              <td class="acoes">
                <a href="/produtos/editar/<%= p.ProdutoID %>" class="btn btn-primary">Editar</a>

                <% if (p.Ativo === 1) { %>
                  <form action="/produtos/inativar/<%= p.ProdutoID %>" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja inativar este produto?')">
                      Inativar
                    </button>
                  </form>
                <% } else { %>
                  <form action="/produtos/ativar/<%= p.ProdutoID %>" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-success">
                      Ativar
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>