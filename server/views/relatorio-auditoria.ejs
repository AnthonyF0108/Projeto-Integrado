<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatório de Auditoria - Agrovale</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="sidebar">
    <h2>Agrovale</h2>
    <ul>
      <li><a href="/dashboard">🏠 Início</a></li>
      <li><a href="/produtos">📦 Produtos</a></li>
      <li><a href="/vendas">💰 Vendas</a></li>
      <li><a href="/estatisticas">📊 Estatísticas</a></li>
      <li><a href="/clientes">👤 Clientes</a></li>
      <li><a href="/relatorios/auditoria">🧾 Auditoria</a></li>
      <li><a href="/logout">🚪 Sair</a></li>
    </ul>
  </div>

  <div class="content">
    <header><h1>Agrovale — Painel Administrativo</h1></header>

    <div class="banner">
      ⚠️ Apenas administradores têm acesso a este relatório.
    </div>

    <form class="filters" method="GET" action="/relatorios/auditoria">
      <div>
        <label for="usuario">Usuário:</label><br>
        <input type="text" name="usuario" id="usuario" value="<%= filtroUsuario || '' %>">
      </div>
      <div>
        <label for="acao">Ação:</label><br>
        <select name="acao" id="acao">
          <option value="">Todas</option>
          <option value="Cadastro de Cliente" <%= filtroAcao === 'Cadastro de Cliente' ? 'selected' : '' %>>Cadastro de Cliente</option>
          <option value="Alteração de Cliente" <%= filtroAcao === 'Alteração de Cliente' ? 'selected' : '' %>>Alteração de Cliente</option>
          <option value="Inativação de Cliente" <%= filtroAcao === 'Inativação de Cliente' ? 'selected' : '' %>>Inativação de Cliente</option>
          <option value="Reativação de Cliente" <%= filtroAcao === 'Reativação de Cliente' ? 'selected' : '' %>>Reativação de Cliente</option>

          <option value="Cadastro de Produto" <%= filtroAcao === 'Cadastro de Produto' ? 'selected' : '' %>>Cadastro de Produto</option>
          <option value="Atualização de Produto" <%= filtroAcao === 'Atualização de Produto' ? 'selected' : '' %>>Atualização de Produto</option>
          <option value="Exclusão de Produto" <%= filtroAcao === 'Exclusão de Produto' ? 'selected' : '' %>>Exclusão de Produto</option>
          <option value="Entrada de Mercadoria" <%= filtroAcao === 'Entrada de Mercadoria' ? 'selected' : '' %>>Entrada de Mercadoria</option>

          <option value="Cadastro de Venda" <%= filtroAcao === 'Cadastro de Venda' ? 'selected' : '' %>>Cadastro de Venda</option>
          <option value="Atualização de Venda" <%= filtroAcao === 'Atualização de Venda' ? 'selected' : '' %>>Atualização de Venda</option>
          <option value="Exclusão de Venda" <%= filtroAcao === 'Exclusão de Venda' ? 'selected' : '' %>>Exclusão de Venda</option>

          <option value="Cadastro de Usuário" <%= filtroAcao === 'Cadastro de Usuário' ? 'selected' : '' %>>Cadastro de Usuário</option>
          <option value="Alteração de Usuário" <%= filtroAcao === 'Alteração de Usuário' ? 'selected' : '' %>>Alteração de Usuário</option>
          <option value="Inativação de Usuário" <%= filtroAcao === 'Inativação de Usuário' ? 'selected' : '' %>>Inativação de Usuário</option>
          <option value="Reativação de Usuário" <%= filtroAcao === 'Reativação de Usuário' ? 'selected' : '' %>>Reativação de Usuário</option>
        </select>
      </div>
      <div>
        <label for="dataInicio">De:</label><br>
        <input type="date" name="dataInicio" id="dataInicio" value="<%= filtroInicio || '' %>">
      </div>
      <div>
        <label for="dataFim">Até:</label><br>
        <input type="date" name="dataFim" id="dataFim" value="<%= filtroFim || '' %>">
      </div>
      <div style="align-self: end;">
        <button type="submit" class="btn btn-primary">Filtrar</button>
      </div>
    </form>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuário</th>
          <th>Ação</th>
          <th>Tabela Afetada</th>
          <th>Registro ID</th>
          <th>Descrição</th>
          <th>Data / Hora</th>
        </tr>
      </thead>
      <tbody>
        <% if (logs.length === 0) { %>
          <tr><td colspan="7" class="text-center">Nenhum registro encontrado.</td></tr>
        <% } else { %>
          <% logs.forEach(log => { %>
            <tr>
              <td><%= log.LogID %></td>
              <td><%= log.Usuario %></td>
              <td><%= log.Acao %></td>
              <td><%= log.TabelaAfetada %></td>
              <td><%= log.RegistroID %></td>
              <td><%= log.Descricao %></td>
              <td><%= new Date(log.DataHora).toLocaleString('pt-BR') %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>